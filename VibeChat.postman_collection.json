{
	"info": {
		"_postman_id": "YOUR_POSTMAN_COLLECTION_ID",
		"name": "Vibe Chat API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"description": "Postman collection for Vibe Chat REST and WebSocket APIs."
	},
	"item": [
		{
			"name": "User Management",
			"item": [
				{
					"name": "Create Guest User",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"nickname\": \"testuser\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/users/guest",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"users",
								"guest"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Room Management",
			"item": [
				{
					"name": "Create Room",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"My Test Room\",\n    \"description\": \"A room created via Postman\",\n    \"isPrivate\": false,\n    \"tags\": [\"postman\", \"test\"]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/rooms",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"rooms"
							]
						}
					},
					"response": []
				},
				{
					"name": "Get Room By ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/rooms/1",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"rooms",
								"1"
							]
						}
					},
					"response": []
				},
				{
					"name": "Search Rooms by Tags",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/rooms/search?tags=postman,test",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"rooms",
								"search"
							],
							"query": [
								{
									"key": "tags",
									"value": "postman,test"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Join Room",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"inviteCode\": \"your-invite-code\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/rooms/1/join",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"rooms",
								"1",
								"join"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Tag Management",
			"item": [
				{
					"name": "Autocomplete Tags",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/tags/autocomplete?q=te",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"tags",
								"autocomplete"
							],
							"query": [
								{
									"key": "q",
									"value": "te"
								}
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Message Management",
			"item": [
				{
					"name": "Get Messages for Room",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/rooms/1/messages?limit=10",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"rooms",
								"1",
								"messages"
							],
							"query": [
								{
									"key": "limit",
									"value": "10"
								}
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "File Upload",
			"item": [
				{
					"name": "Upload Media",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "file",
									"type": "file",
									"src": "/path/to/your/image.jpg" 
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/api/upload/media",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"upload",
								"media"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Reporting",
			"item": [
				{
					"name": "Report Message",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"reason\": \"SPAM\",\n    \"details\": \"This message contains spam.\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/messages/1/report",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"messages",
								"1",
								"report"
							]
						}
					},
					"response": []
				}
			]
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Set base_url environment variable to http://localhost if not already set"
					"if (!pm.environment.get(\"base_url\")) {\n    pm.environment.set(\"base_url\", \"http://localhost\");\n}"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost",
			"type": "string"
		}
	]
}
